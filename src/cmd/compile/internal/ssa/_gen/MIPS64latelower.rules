// use zero register
(MOVVconst [0]) => (ZERO)

// omit unsigned extension
(MOVBUreg x) && ssa.ZeroUpper56Bits(x) => x
(MOVHUreg x) && ssa.ZeroUpper48Bits(x) => x
(MOVWUreg x) && ssa.ZeroUpper32Bits(x) => x
